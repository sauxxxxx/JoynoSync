# Copy this file to .env.supabase.functions for local Edge Function work.
# Never commit the populated file or paste production values into this template.

# Supabase runtime
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_ROLE_KEY=replace_me
PUBLIC_BASE_URL=http://127.0.0.1:4173
CORS_ORIGIN=http://127.0.0.1:4173

# Email provider (only required when the Gmail functions are deployed)
GOOGLE_OAUTH_CLIENT_ID=replace_me
GOOGLE_OAUTH_CLIENT_SECRET=replace_me
GOOGLE_OAUTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/email-google-auth-callback
GOOGLE_OAUTH_SCOPES=https://www.googleapis.com/auth/gmail.send
GOOGLE_OAUTH_REFRESH_TOKEN=
GOOGLE_OAUTH_SENDER_EMAIL=
EMAIL_DEFAULT_RETURN_URL=http://127.0.0.1:4173
EMAIL_STATE_SECRET=replace_with_a_long_random_value
EMAIL_TOKEN_ENCRYPTION_KEY=replace_with_a_long_random_value

# RingCentral JWT + RingOut workspace integration
RINGCENTRAL_SERVER_URL=https://platform.ringcentral.com
RINGCENTRAL_CLIENT_ID=replace_me
RINGCENTRAL_CLIENT_SECRET=replace_me
RINGCENTRAL_JWT=replace_me
RINGCENTRAL_ACCOUNT_ID=~
RINGCENTRAL_DEFAULT_EXTENSION_ID=~
RINGCENTRAL_DEFAULT_EXTENSION_REF=
RINGCENTRAL_DEFAULT_USER_REF=
RINGCENTRAL_DEFAULT_CALLER_ID=
RINGCENTRAL_DEFAULT_DIRECT_NUMBER=
RINGCENTRAL_WEBHOOK_URL=https://your-project.supabase.co/functions/v1/ringcentral-webhook
RINGCENTRAL_WEBHOOK_VALIDATION_TOKEN=replace_with_a_long_random_value
