{
  "name": "joynosync",
  "version": "1.0.0",
  "description": "Internal operations CRM for leads, work, attendance, and RingCentral-assisted calling.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "http-server public -p 4173 -c-1",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:smoke": "playwright test",
    "test:smoke:headed": "playwright test --headed",
    "release:check": "powershell -ExecutionPolicy Bypass -File ./scripts/release-check.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "http-server": "^14.1.1",
    "supabase": "^2.111.0"
  }
}
